{
  "name": "swarmup",
  "version": "0.3.0-beta.3",
  "private": true,
  "description": "A team of AI agents and one human working one queue, with tasks as files in git",
  "license": "MIT",
  "repository": "github:dawid-ai/swarmup",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p packages/desktop/ui/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "leaks": "node scripts/check-leaks.mjs",
    "swarmup": "node packages/cli/dist/main.js",
    "ops": "node packages/cli/dist/ops.js",
    "prepare": "node scripts/setup-hooks.mjs",
    "build:desktop": "tsc -b && pnpm --filter @swarmup/desktop run build:ui",
    "desktop": "pnpm run build:desktop && pnpm --filter @swarmup/desktop run start",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "check:record": "node scripts/record-check.mjs",
    "dist": "pnpm run build:desktop && pnpm --filter @swarmup/desktop run dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "happy-dom": "^21.0.4",
    "jsdom": "^29.1.1",
    "marked": "^18.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  }
}
