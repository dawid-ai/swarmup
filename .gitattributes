# Keep every text file LF on every OS; Windows checkouts with core.autocrlf=true stay LF too.
* text=auto eol=lf
*.png binary
*.ico binary
*.bmp binary
*.icns binary
*.pem binary

# Internal paths: git archive leaves them out, and the docs on swarmup.tech skip them (the docs
# build in dawid-ai/swarmup-web reads these attributes). The task store and the internal docs live
# in a private repo of their own; these lines keep a stray copy out of both.
.agent-ops/** export-ignore
.agent-ops export-ignore
.swarmup/** export-ignore
.swarmup export-ignore
docs/proposals/** export-ignore
# Launch post drafts: Dawid edits and posts them by hand; they never ship in the export.
docs/launch/** export-ignore
# Internal working documents: the rename inventory and research reports.
docs/swarmup-rename.md export-ignore
docs/research/** export-ignore
# The notes of the 0.2 betas. The public CHANGELOG.md and UPDATES.md start at 0.3.0-beta.1.
docs/history/** export-ignore
