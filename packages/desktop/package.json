{
  "name": "@swarmup/desktop",
  "version": "0.3.0-beta.3",
  "private": true,
  "description": "SwarmUp desktop: the Electron control room on top of swarmupd",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "dependencies": {
    "@swarmup/core": "workspace:*",
    "@swarmup/supervisor": "workspace:*",
    "electron-updater": "^6.8.11"
  },
  "scripts": {
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "start": "electron .",
    "package": "node scripts/package.mjs",
    "dist": "node scripts/package.mjs && electron-builder --win --config electron-builder.yml --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource/chakra-petch": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.468.0",
    "marked": "^18.1.2",
    "mp4-muxer": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
